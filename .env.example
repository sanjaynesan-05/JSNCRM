GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Gmail STARTTLS uses 587 by default. Set 465 for implicit TLS if needed.
SMTP_PORT=587
PORT=5000
CLIENT_URL=http://localhost:5173
# Keep the browser and API business calendar aligned. Defaults to India time.
BUSINESS_TIME_ZONE=Asia/Kolkata
VITE_BUSINESS_TIME_ZONE=Asia/Kolkata
# Local default is loopback. Hosted deployments should set HOST=0.0.0.0 and configure app authentication below.
HOST=127.0.0.1
# Required in production; use a unique username and a long password (16+ characters).
APP_USERNAME=
APP_PASSWORD=
# Optional. Defaults to %LOCALAPPDATA%\JSN Designs Business Studio\business.sqlite on Windows.
DATABASE_PATH=
# Optional. Defaults to %LOCALAPPDATA%\JSN Designs Business Studio\backups
BACKUP_DIR=
# Razorpay Payment Gateway (server-side only; begin in test mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MODE=test
# Optional public HTTPS endpoint for a hosted webhook receiver; not used by localhost.
RAZORPAY_WEBHOOK_PUBLIC_URL=
# Optional application URL used in external deployment documentation.
APP_BASE_URL=http://localhost:5173
